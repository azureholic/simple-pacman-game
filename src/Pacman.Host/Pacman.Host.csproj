<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <SpaRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\web'))</SpaRoot>
    <SpaStampFile>$(BaseIntermediateOutputPath)spa-npm-ci.stamp</SpaStampFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <SpaInstallInputs Include="$(SpaRoot)\package.json;$(SpaRoot)\package-lock.json" />
    <SpaInputs Include="$(SpaRoot)\package.json;$(SpaRoot)\package-lock.json;$(SpaRoot)\tsconfig.json;$(SpaRoot)\tsconfig.app.json;$(SpaRoot)\tsconfig.node.json;$(SpaRoot)\vite.config.ts;$(SpaRoot)\index.html;$(SpaRoot)\public\**\*;$(SpaRoot)\src\**\*;$(SpaRoot)\tests\**\*" />
  </ItemGroup>

  <Target Name="EnsureSpaDepsStampValid" BeforeTargets="InstallWebFrontendDeps" Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipSpaBuild)' != 'true'">
    <PropertyGroup>
      <SpaDepsPresent Condition="Exists('$(SpaRoot)\node_modules\typescript\bin\tsc') AND Exists('$(SpaRoot)\node_modules\vite\bin\vite.js') AND Exists('$(SpaRoot)\node_modules\@vitejs\plugin-react\package.json') AND Exists('$(SpaRoot)\node_modules\@types\react\package.json') AND Exists('$(SpaRoot)\node_modules\@types\react-dom\package.json') AND Exists('$(SpaRoot)\node_modules\@types\node\package.json') AND Exists('$(SpaRoot)\node_modules\react\package.json') AND Exists('$(SpaRoot)\node_modules\react-dom\package.json')">true</SpaDepsPresent>
    </PropertyGroup>
    <Delete Files="$(SpaStampFile)" Condition="'$(SpaDepsPresent)' != 'true' AND Exists('$(SpaStampFile)')" />
  </Target>

  <Target Name="InstallWebFrontendDeps" Inputs="@(SpaInstallInputs)" Outputs="$(SpaStampFile)" Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipSpaBuild)' != 'true'">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci --include=dev --no-audit --no-fund" EnvironmentVariables="NODE_ENV=development" StandardErrorImportance="High" />
    <Touch Files="$(SpaStampFile)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildWebFrontend" DependsOnTargets="InstallWebFrontendDeps" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths;Build" Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" StandardErrorImportance="High" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
    <Copy SourceFiles="@(SpaDistFiles)" DestinationFiles="@(SpaDistFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="RegisterGeneratedSpaAssets" AfterTargets="BuildWebFrontend" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths;ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <Content Remove="wwwroot\**\*" />
      <Content Include="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
